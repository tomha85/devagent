# Choose the default provider: openai | claude | grok
DEFAULT_PROVIDER=claude

# API keys - fill only the provider(s) you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-sonnet-4-20250514
GROK_MODEL=grok-4

# OpenAI-compatible xAI endpoint
XAI_BASE_URL=https://api.x.ai/v1
