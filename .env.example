# Select: openai | claude | grok
DEVAGENT_LLM_PROVIDER=openai

# Optional model overrides
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-sonnet-4-20250514
GROK_MODEL=grok-4

# API keys - copy this file to .env and fill only the provider(s) you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# OpenAI-compatible xAI endpoint
XAI_BASE_URL=https://api.x.ai/v1

# Workspace the agent is allowed to inspect/change. Default: current directory.
DEVAGENT_WORKSPACE=.

# Local agent state. This path is ignored by git.
DEVAGENT_STATE_DIR=.devagent
